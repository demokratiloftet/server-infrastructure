APP_ORIGIN=http://127.0.0.1:3100
ATPROTO_DOCKER_NETWORK=server-infrastructure_default
PDS_DOCKER_HOST=pds
PDS_DOCKER_PORT=3000
# Separate synthetic accounts on the VPS PDS; do not use local .test accounts.
ORGANISER_HANDLE=
ORGANISER_PASSWORD=
ISSUER_HANDLE=
ISSUER_PASSWORD=
ISSUER_DID=
# Generate: openssl rand -hex 24
DEMO_ACCESS_KEY=

# Auth state/links persist in an encrypted SQLite volume. Keep this key stable
# and back it up separately from the database. Generate: openssl rand -hex 32
AUTH_ENCRYPTION_KEY=
# Canonical HTTPS identities advertised by your private PDS/PLC.
ATPROTO_PDS_ORIGIN=https://pds.dev.demokratiloftet.no
ATPROTO_PLC_URL=https://plc.dev.demokratiloftet.no
# Exact origins only. They must resolve to private/tailnet IPs at startup.
AUTH_FETCH_ROUTES_JSON={"https://pds.dev.demokratiloftet.no":"https://pds.dev.demokratiloftet.no","https://plc.dev.demokratiloftet.no":"https://plc.dev.demokratiloftet.no"}
OIDC_PROVIDERS_JSON=[]

# Explicit OIDC entry providers; disabled by default. No shared provisioning yet.
IDENTITY_LOGIN_PROVIDERS_JSON=[]
