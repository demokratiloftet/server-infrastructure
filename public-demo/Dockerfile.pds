FROM node:24.22.1-alpine3.23@sha256:0468540aa58203ff9e40c2aab3907c52644ab818af6176b1c70a026137dc92a2 AS security_runtime
FROM node:24.22.1-bookworm-slim@sha256:55fb5f5a527ea2c5c4a95f963e48ef90aa38c7b346054fdc8ee9957a2b55d205 AS typescript
WORKDIR /source
COPY package.json package-lock.json tsconfig.json ./
RUN npm ci --ignore-scripts
COPY public-demo ./public-demo
COPY spaces-demo ./spaces-demo
COPY scripts ./scripts
RUN npm run build

FROM ghcr.io/bluesky-social/pds@sha256:05e164855fa1a3cf251c002210c46f8c86e7ae27bddc7a96045da25483840826
USER root
RUN rm -rf /usr/local/lib/node_modules/npm
COPY --from=security_runtime /usr/local/bin/node /usr/local/bin/node
COPY --from=security_runtime /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/npm
COPY --from=typescript /source/dist/public-demo/patch-pds.js /tmp/patch-pds.mjs
COPY --from=typescript /source/dist/public-demo/pds-boundary.js /tmp/pds-boundary.mjs
RUN node /tmp/patch-pds.mjs

RUN mkdir -p /app/data && chown node:node /app/data
USER node
