# Update Node without changing the pinned upstream application.
ARG BASE_IMAGE
ARG NODE_RUNTIME
FROM ${NODE_RUNTIME} AS security_runtime
FROM ${BASE_IMAGE}
ARG FINAL_USER=node
ARG REBUILD_SQLITE=0
USER root
RUN rm -rf /usr/local/lib/node_modules/npm
COPY --from=security_runtime /usr/local/bin/node /usr/local/bin/node
COPY --from=security_runtime /usr/local/include/node /usr/local/include/node
COPY --from=security_runtime /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/npm
# The legacy feed generator crosses the Node ABI boundary from 20 to 22.
RUN if [ "$REBUILD_SQLITE" = 1 ]; then apk add --no-cache --virtual .node-build-deps python3 make g++ && node /usr/local/lib/node_modules/npm/node_modules/node-gyp/bin/node-gyp.js rebuild --directory=/app/node_modules/better-sqlite3 --nodedir=/usr/local && apk del .node-build-deps; fi
USER ${FINAL_USER}
RUN node --version
