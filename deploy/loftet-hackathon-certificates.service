[Unit]
Description=Export only the hackathon TLS certificate for the public app gateway

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/bin/python3 /root/loftet-public-hackathon-20261015/public-hackathon.py tls
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/etc/loftet-deploy/public-hackathon/tls
