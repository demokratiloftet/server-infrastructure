# Domain Configuration
# Hostnames are {service}.${PARTITION}.${DOMAIN}, e.g. social.dev.demokratiloftet.no
# DOMAIN must be a zone the DNS API can write to. ASCII only: atproto handles
# and did:web identifiers reject non-ASCII, so no "ø" here.
DOMAIN=demokratiloftet.no
PARTITION=dev

# Tailscale Configuration
TAILSCALE_CLIENT_SECRET=tskey-client-xxx
TS_TAG=test

# Vercel DNS Configuration
VERCEL_API_TOKEN=your-vercel-api-token
VERCEL_TEAM_ID=team_xxxxxxxxxxxxxxxxxxxxxxxx

# Let's Encrypt Configuration
ACME_EMAIL=your-email@example.com

# Service credentials, replacing upstream's committed dev defaults.
# Generate with: openssl rand -hex 32
# The three keys and PDS_PLC_ROTATION_KEY are secp256k1 private keys and are
# baked into DIDs on first boot: changing them later orphans existing accounts.
POSTGRES_PASSWORD=
PDS_ADMIN_PASSWORD=
PDS_JWT_SECRET=
PDS_PLC_ROTATION_KEY=
RELAY_ADMIN_PASSWORD=
BSKY_ADMIN_PASSWORD=
BSKY_SERVICE_SIGNING_KEY=
OZONE_ADMIN_PASSWORD=
OZONE_SIGNING_KEY_HEX=

# Optional default moderation labeler
OZONE_ADMIN_DID=

# Upstream interpolation compatibility; Cloudflare is replaced by the overlay.
CF_API_EMAIL=
CF_DNS_API_TOKEN=
